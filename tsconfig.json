{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "strictNullChecks": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "types": ["vite-plugin-font/src/font"],

    // 設定路徑別名
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"], // 設定 @/* 代表 src/*
      "@assets/*": ["src/assets/*"] // 設定 @assets 代表 src/assets/
    }
  },
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"]
}
