---
import { __ } from "../utils/i18n";
import { BASE_URL } from "../utils/config";

type Props = {
  prevUrl: string | null;
  nextUrl: string | null;
  currentPage: number;
  lastPage: number;
  url?: string;
  variant?: "solid" | "glass";
};

const {
  prevUrl,
  nextUrl,
  currentPage,
  lastPage,
  url = "",
  variant = "solid",
} = Astro.props;

// 確認前後兩頁是否存在，用於顯示在底部頁碼導航
const lowerBound = currentPage - 2 > 0 ? currentPage - 2 : 1;
const upperBound = currentPage + 2 < lastPage ? currentPage + 2 : lastPage;
---

{/* AOS 實作於 AfterFooter ， fade-up 為捲動的動畫效果 */}
{/* 新增一個 class ，用來控制當 BOTTOM_BANNER 存在時，底部頁碼欄位會變淡 */}
<nav
  id="page-nav"
  data-aos="fade-up"
  class:list={[{ "is-glass": variant === "glass" }]}
>
  {
    prevUrl && (
      <a href={`${BASE_URL}${prevUrl}`} class="extend prev" rel="prev">
        {"« " + __("prev")}
      </a>
    )
  }
  {
    // 讓使用者可以直接回到第一頁
    lowerBound > 1 && (
      <a href={`${BASE_URL}${url}/`} class="page-number">
        1
      </a>
    )
  }
  {lowerBound > 2 && <span class="space">…</span>}
  {
    Array.from(
      { length: upperBound - lowerBound + 1 },
      (_, index) => index + lowerBound,
    ).map((page) => (
      // 不是第一頁就會在 url 顯示頁碼，同時把當前 page 加上 current 這個 class
      <a
        href={page > 1 ? `${BASE_URL}${url}/${page}` : `${BASE_URL}${url}/`}
        class={`page-number ${page === currentPage ? "current" : ""}`}
      >
        {page}
      </a>
    ))
  }
  {upperBound < lastPage - 1 && <span class="space">…</span>}
  {
    // 讓讀者直接到最後一頁
    upperBound < lastPage && (
      <a href={`${BASE_URL}${url}/${lastPage}`} class="page-number">
        {lastPage}
      </a>
    )
  }
  {
    nextUrl && (
      <a href={`${BASE_URL}${nextUrl}`} class="extend next" rel="next">
        {__("next") + " »"}
      </a>
    )
  }
</nav>

<style lang="scss">
  // :global(html:not(.has-active-bottom-banner)) #page-nav.is-glass {
  //   border-color: transparent;
  //   background: var(--color-wrap);
  // }

  // :global(html:not(.has-active-bottom-banner)) #page-nav.is-glass:hover {
  //   border-color: transparent;
  //   background: var(--color-wrap);
  // }

  :global(html:not(.bottom-bg-active)) {
    #page-nav.is-glass {
      border-color: transparent;
      background: var(--color-wrap);

      &:hover {
        border-color: transparent;
        background: var(--color-wrap);
      }

      .current {
        background: var(--red-1);
        box-shadow: var(--shadow-red-6-shadow);

        &:hover {
          background: var(--red-2);
        }
      }
    }
    
  }
  
  #page-nav {
    margin: 36px auto;

    border-radius: 12px;
    background: var(--color-wrap);

    // 如果 bottom banner 會被蓋到，就會攜帶這個 class ，讓 page nav bar 變成透明
    &.is-glass {
      // 毛玻璃效果並不好，取消使用
      // backdrop-filter: blur(8px);
      // -webkit-backdrop-filter: blur(8px);

      // border: 1px solid color-mix(in srgb, var(--color-wrap), transparent 70%);
      // 只有 hover 才加 border，會有先白後黑的視覺跳動 (從 none 到半透) ，所以加上這行
      border: 1px solid transparent;
      background: color-mix(in srgb, var(--color-wrap), transparent 100%);

      // 控制當有 bottom banner 的情況，被 hover 時為了讓使用者更清楚有選到，改變背景顏色
      &:hover {
        // 舊方案：直接切換 border 屬性
        // border: 1px solid color-mix(in srgb, var(--color-wrap), transparent 70%);
        border-color: color-mix(in srgb, var(--color-wrap), transparent 70%);
        background: color-mix(in srgb, var(--color-wrap), transparent 40%);
      }

      @media screen and (max-width: 767px) {
        border-color: transparent;
        background: var(--color-wrap);

        &:hover {
          border-color: transparent;
          background: var(--color-wrap);
        }
      }

      .current {
        background: color-mix(in srgb, var(--red-2), transparent 60%);
        box-shadow: 0 0 8px var(--color-red-3-shadow);

        /* 這個是當有 BOTTOM_BANNER 的情況下，滑鼠 hover 的效果 */
        /* 重點：如果不在這裡寫 &:hover => ID(100) + Class(10)*2 = 120 分 > 111 分 */
        /* 因為比 a &:hover 分數還要高，只能在裡面宣告行為 */
        &:hover {
          background: var(--red-1);
        }
      }
    }

    text-align: center;
    color: var(--grey-9);
    overflow: hidden;
    transition: 0.8s;

    // 任何狀態下被 hover
    &:hover {
      box-shadow: var(--shadow-card);
    }

    a,
    span {
      padding: 10px 16px;
    }

    a {
      color: var(--grey-9);
      text-decoration: none;
      transition: 0.2s;

      /* #page-nav a:hover 總共 ID(100) + Pseudo(10) + Tag a(1) = 111 分 */
      &:hover {
        background: var(--red-2);
        box-shadow: var(--shadow-red-6-shadow);
        color: #fff;
      }
    }

    .prev {
      float: left;
      padding: 16px;
    }

    .next {
      float: right;
      padding: 16px;
    }

    .page-number {
      display: inline-block;
      border-radius: 8px;
      margin: 6px;

      @media screen and (max-width: 479px) {
        display: none;
      }
    }

    .current {
      background: var(--red-1);
      color: #fff;
      font-weight: bold;
      box-shadow: var(--shadow-red-6-shadow);

      @media screen and (max-width: 479px) {
        display: inline-block;
      }
    }

    .space {
      display: inline-block;
      margin: 6px;
      color: var(--color-border);

      @media screen and (max-width: 479px) {
        display: none;
      }
    }
  }
</style>
