---
import { Icon } from "astro-icon/components";

import { totalCount, totalReadingTime } from "../utils/wordCount";
import { SITE, FOOTER, BASE_URL } from "../utils/config";
import { __ } from "../utils/i18n";

const totalcount = await totalCount();
const totalmin2read = await totalReadingTime();
---

<footer id="footer">
  <div style="width: 100%; overflow: hidden">
    {/* 頁底會不斷循環的跑馬燈分隔線 */}
    <div class="footer-line"></div>
  </div>
  <div class="outer">
    <div id="footer-info" class="inner">
      {/* 劃分一個 div 區塊給 copyright 、建置時間、網頁標誌及作者 */}
      <div>
        <Icon name="fa6-regular:copyright" />
        &thinsp; {/* 用窄空格，盡量不改底下的 css ，不然還要多用容器處理 */}
        {
          // 起始時間，正常應該是 number 型別
          // 為了顯示月份，在 utils/config.ts 中改成 string 型別
          FOOTER.since
        }
        {
          // 用三元運算子判斷是否顯示年份範圍，範例：parseInt("2026/02") = 2026
          parseInt(String(FOOTER.since)) < new Date().getFullYear()
            ? ` ~ ${new Date().getFullYear()}`
            : " ~ Now"
        }
        &nbsp;
        {/* 這個 class 的圖片在 style lang ... 那邊有宣告 */}
        <span class="footer-info-sep"></span>
        {SITE.author || SITE.title}
      </div>
      {
        // powered by 採用條件渲染
        // JS 表達式的 short-circuit evaluation ，所以當渲染後也是 div 區塊
        FOOTER.powered && (
          <div>
            {__("powered_by")}&nbsp;
            <a
              href="https://astro.build/"
              rel="noopener external nofollow noreferrer"
              target="_blank"
            >
              Astro
            </a>
            &nbsp; Theme.
            <a
              href="https://github.com/D-Sketon/astro-theme-reimu"
              rel="noopener external nofollow noreferrer"
              target="_blank"
            >
              Reimu
            </a>
          </div>
        )
      }
      {
        // // count 採用條件渲染，顯示總字數和總閱讀時間
        // FOOTER.count && (
        //   <div>
        //     <Icon name="fa6-solid:paintbrush" />
        //     &nbsp;
        //     {totalcount}
        //     &nbsp;|&nbsp;
        //     <Icon name="fa6-solid:mug-saucer" />
        //     &nbsp;
        //     {totalmin2read}
        //   </div>
        // )

        // count 採用條件渲染
        FOOTER.count && (
          // 新增 metric-row 管理左右兩側的 section ， metric : 度量、指標
          // 把總字數和總閱讀時間分成左右兩邊，這個 div 本身會受到置中影響
          <div class="footer-metric-row">
            <div class="footer-metric-left">
              <Icon name="fa6-solid:paintbrush" />
              &nbsp;
              {totalcount}
            </div>
            <div class="footer-metric-sep">|</div>
            <div class="footer-metric-right">
              <Icon name="fa6-solid:mug-saucer" />
              &nbsp;
              {totalmin2read}
            </div>
          </div>
        )
      }
      {
        // FOOTER.busuanzi && (
        //   <div>
        //     <Icon name="fa6-solid:eye" />
        //     &nbsp;
        //     <span id="busuanzi_container_site_pv">
        //       {__("busuanzi.pv")}&nbsp;
        //       <span id="busuanzi_value_site_pv" />
        //     </span>
        //     &nbsp;|&nbsp;
        //     <Icon name="fa6-solid:user" />
        //     &nbsp;
        //     <span id="busuanzi_container_site_uv">
        //       {__("busuanzi.uv")}&nbsp;
        //       <span id="busuanzi_value_site_uv" />
        //     </span>
        //   </div>
        // )

        FOOTER.busuanzi && (
          // 新增 metric-row 管理左右兩側的 section
          <div class="footer-metric-row">
            <div class="footer-metric-left">
              <Icon name="fa6-solid:eye" />
              &nbsp;
              <span id="busuanzi_container_site_pv">
                {__("busuanzi.pv")}&nbsp;
                <span id="busuanzi_value_site_pv" />
              </span>
            </div>
            <div class="footer-metric-sep">|</div>
            <div class="footer-metric-right">
              <Icon name="fa6-solid:user" />
              &nbsp;
              <span id="busuanzi_container_site_uv">
                {__("busuanzi.uv")}&nbsp;
                <span id="busuanzi_value_site_uv" />
              </span>
            </div>
          </div>
        )
      }
      {
        FOOTER.icp?.icpnumber && (
          <div class="footer-beian">
            <a
              target="_blank"
              rel="noopener external nofollow noreferrer"
              href="https://beian.miit.gov.cn"
            >
              {FOOTER.icp.icpnumber}
            </a>
          </div>
        )
      }
      {
        FOOTER.icp?.beian && FOOTER.icp?.recordcode && (
          <div class="footer-beian">
            <img
              style="object-fit: contain;margin-right: 2px;"
              src="data:image/png;base64,"
              alt=""
            />
            <a
              target="_blank"
              rel="noopener external nofollow noreferrer"
              href={`https://beian.mps.gov.cn/#/query/webSearch?code=${FOOTER.icp.recordcode}`}
            >
              {FOOTER.icp.beian}
            </a>
          </div>
        )
      }
      {
        FOOTER.moe_icp?.icpnumber && (
          <div class="footer-beian">
            <img
              style="object-fit: contain;margin-right: 2px;"
              src="https://icp.gov.moe/images/ico64.png"
              alt=""
              width="24"
              height="24"
            />
            <a
              target="_blank"
              rel="noopener external nofollow noreferrer"
              href={`https://icp.gov.moe/?keyword=${FOOTER.moe_icp.icpnumber}`}
            >
              萌ICP备{FOOTER.moe_icp.icpnumber}号
            </a>
          </div>
        )
      }
    </div>
  </div>
</footer>

{/* 定義變數為 .footer-info-sep 會用到的圖標 */}
<style lang="stylus" define:vars={{ imageUrl: 'url('+`${BASE_URL}/images/taichi.png`+')' }}>
  #footer {
    background: linear-gradient(
      to top,
      var(--color-footer-background) 50%,
      transparent
    );
    padding: 40px 0 20px;
    color: var(--grey-9);
    transition: 1s;

    &:hover {
      .footer-line {
        transition: opacity 0.3s;
        opacity: 0.5;
      }
    }

    a {
      color: var(--color-link);
      text-decoration: none;

      &:hover {
        text-decoration: underline;
      }
    }
  }

  .footer-beian {
    a {
      color: var(--grey-9) !important;
    }
  }

  .footer-line {
    margin: 20px 0 40px;
    opacity: 0.3;
    width: 200%;
    height: 10px;
    background: linear-gradient(to left, var(--red-1) 50%, transparent 0%) repeat-x 0 0 / 100px 10px;
    transition: opacity 0.3s;
    animation: transform-all 3s linear infinite;
    filter: drop-shadow(0px 0px 2px var(--red-1));
  }

  #footer-info {
    line-height: 1.67;
    font-size: 0.85em;

    > div { 
      // 使用子代選擇器 > ，不然會影響到 .footer-metric-row 的子元素
      margin: 8px 0;
      display: flex;
      justify-content: center;
      align-items: center;
    }
  }

  // 利用 metric 這個 class 管理左右兩側的 section
  // 因為把空間撐滿了，後續只要子元素都設定 flex: 1 就會每個子元素空間都相同
  .footer-metric-row {
    width: 100%;
  }

  .footer-metric-left {
    flex: 1;              /* 佔據剩餘空間的一半 */
    display: flex;
    justify-content: flex-end; /* 內容靠右對齊 (向中線靠攏) */
    align-items: center;
  }

  .footer-metric-right {
    flex: 1;              /* 佔據剩餘空間的一半 */
    display: flex;
    justify-content: flex-start; /* 內容靠左對齊 (向中線靠攏) */
    align-items: center;
  }

  .footer-metric-sep {
    margin: 0 15px;
    opacity: 0.5;
  }

  // footer 中的圖標
  .footer-info-sep {
    width: 24px;
    height: 24px;
    opacity: 0.8;
    // 利用這種方式把圖片的 url (javascript) 放入 css
    // 定義變數在 style lang ... define:vars= ...
    background: var(--imageUrl) no-repeat center / 80%;

    animation: rotate-all 3s infinite;
    animation-timing-function: linear;
  }

  @keyframes rotate-all {
    100% {
      transform: rotate(360deg);
    }
  }

  @keyframes transform-all {
    100% {
      transform: translateX(-100px);
    }
  }
</style>
