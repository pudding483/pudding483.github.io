---
// src/pages/about.astro

// 保持與 MarkdownLayout 一致，確保 H2, ul, li 長得一樣
import "../styles/base.stylus";
import "katex/dist/katex.min.css";
import "../styles/markdown.stylus";

import { BASE_URL } from "../utils/config";
import { __ } from "../utils/i18n";

import BaseLayout from "../layouts/BaseLayout.astro";
import HeaderTitle from "../components/partial/header/HeaderTitle.astro";
import PostDate from "../components/post/Date.astro";
import Comment from "../components/post/Comment.astro";
import Footer from "../components/Footer.astro";

const pubDate = new Date("2026-02-09"); // 或是 new Date() 代表今天
// const description = "關於 483 的 blog"; for SEO, but due to i18n, shelve it for now
---

<BaseLayout title={__("about")} isPost={true} toc={false}>
  <HeaderTitle title={__("about")} url={`${BASE_URL}/about`} slot="header" />

  <section id="main" aria-label="Main content">
    <article
      class="article"
      itemprop="blogPost"
      itemscope
      itemtype="https://schema.org/BlogPosting"
      data-aos="fade-up"
    >
      <div class="article-inner">
        <div class="article-meta">
          <PostDate pubDate={pubDate} />
        </div>

        <div class="hr-line"></div>

        <div class="article-entry" itemprop="articleBody">
          {/* 自我介紹區塊 - 你可以在這裡自由寫 HTML/CSS 排版 */}
          <h2>本站信息</h2>
          <ul>
            <li><strong>站名：</strong> 483's Blog</li>
            <li><strong>站長：</strong> 483</li>
            <li>
              <strong>地址：</strong>
              <a href="https://pudding483.github.io/"
                >https://pudding483.github.io/</a
              >
            </li>
          </ul>

          <br />

          <h2>關於站長</h2>
          <ul>
            <li><strong>名字：</strong> 沈柏安</li>
            <li><strong>興趣：</strong> CTF、象棋</li>
            <li><strong>CTF player ID：</strong> pudding483</li>
          </ul>
        </div>

        <slot name="footer" />
      </div>
    </article>

    <Comment comment={true} />
  </section>

  <Footer slot="footer" />
</BaseLayout>

<style>
  .hr-line {
    margin: 12px 36px;
    opacity: 0.3;
    height: 4px;
    background-image: linear-gradient(
      to right,
      var(--red-0) 50%,
      transparent 0%
    );
    background-size: 50px 4px;
    background-repeat: repeat-x;
    filter: drop-shadow(0px 0px 2px var(--red-1));
    transition:
      opacity 0.3s,
      color 0.3s;

    &:hover {
      opacity: 0.5;
    }
  }

  .article-inner {
    background: var(--color-wrap);
    border-radius: 12px;
    display: flow-root;
    transition: 0.3s;
  }

  .article-meta {
    display: flex;
    flex-direction: column;
    padding: 20px 36px 0;

    @media screen and (max-width: 767px) {
      padding: 20px 16px 0;
    }
  }

  /* === 可以在下面對 about 頁面做特殊調整 === */
  /* 例如調整 article-entry 裡的 padding */
  .article-entry {
    padding: 0 36px 20px;
  }

  @media screen and (max-width: 767px) {
    .article-entry {
      padding: 0 16px 20px;
    }
  }
</style>
