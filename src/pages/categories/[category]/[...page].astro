---
import { getCollection, type CollectionEntry } from "astro:content";

import BaseLayout from "../../../layouts/BaseLayout.astro";
import { __ } from "../../../utils/i18n";
import Footer from "../../../components/Footer.astro";
import CategoryList from "../../../components/partial/CategoryList.astro";
import HeaderTitle from "../../../components/partial/header/HeaderTitle.astro";
import ArchiveList from "../../../components/ArchiveList.astro";
import Pagination from "../../../components/Pagination.astro";
import { BASE_URL } from "../../../utils/config";

// 與 page 類似，但是這裡多了 [category] 參數，代表有兩層的動態路由
export async function getStaticPaths({ paginate }: { paginate: Function }) {
  const posts = await getCollection("blog");
  const categoriesMap: Map<string, CollectionEntry<"blog">[]> = new Map();
  posts.forEach((post) => {
    if (Array.isArray(post.data.categories)) {
      post.data.categories.forEach((category) => {
        if (categoriesMap.has(category)) {
          categoriesMap.get(category)!.push(post);
        } else {
          categoriesMap.set(category, [post]);
        }
      });
    }
  });
  const categories = [...categoriesMap.keys()];
  // 每一個類別都要分頁
  return [...categoriesMap.entries()]
    .map((categoryMap) => {
      categoryMap[1].sort((a, b) => {
        return b.data.pubDate.getTime() - a.data.pubDate.getTime();
      });
      return categoryMap;
    })
    .flatMap((categoryMap) => {
      return paginate(categoryMap[1], {
        // categoryMap[1] 是該類別的文章列表
        params: { category: categoryMap[0] },
        props: { categories },
        // 類別頁面每類顯示幾篇文章
        pageSize: 7,
      });
    });
}

type Props = {
  page: {
    data: CollectionEntry<"blog">[];
    url: {
      prev: string;
      next: string;
    };
    currentPage: number;
    lastPage: number;
  };
  categories: string[];
};

const { page, categories } = Astro.props;
const { category } = Astro.params;
---

{/* 這裡用 categories 因為 i18n 字典裡已經有了這個 key */}
<BaseLayout title={`${__("categories")}: ${category}`}>
  <!-- Header -->
  <HeaderTitle
    title={`${__("categories")}: ${category}`}
    url={`${BASE_URL}/categories/${category}`}
    slot="header"
  />
  <!-- Content -->
  <section id="main" aria-label="Main content">
    <div class="archives-outer-wrap" data-aos="fade-up">
      <CategoryList categories={[...categories]} />
      <ArchiveList page={page} type="archives" />
    </div>
    <Pagination
      prevUrl={page.url.prev}
      nextUrl={page.url.next}
      currentPage={page.currentPage}
      lastPage={page.lastPage}
      url={`/categories/${category}`}
      variant="solid"
    />
  </section>
  <!-- Footer -->
  <Footer slot="footer" />
</BaseLayout>

<style>
  .archives-outer-wrap {
    background: var(--color-wrap);
    border-radius: 12px;
    padding: 16px 0;
  }
</style>
