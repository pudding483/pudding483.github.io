---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { Icon } from "astro-icon/components";

import { SITE, BASE_URL, HOME_CATEGORIES, BANNER } from "../utils/config";
import { formatDate } from "../utils/formatDate";
import { urlFor } from "../utils/urlFor";
import { _p } from "../utils/i18n";
import { wordCount, readingTime } from "../utils/wordCount";

import BaseLayout from "../layouts/BaseLayout.astro";
import randomCover from "../utils/randomCover";
import HeaderTitle from "../components/partial/header/HeaderTitle.astro";
import HeaderSubTitle from "../components/partial/header/HeaderSubTitle.astro";
import HomeCategories from "../components/HomeCategories.astro";
import Pagination from "../components/Pagination.astro";
import BottomBackground from "../components/BottomBackground.astro"; // 用來實作底部大圖
import Footer from "../components/Footer.astro";
// 動態計算有哪些 PostWrap 需要透明，BottomBanner 才不會被遮擋
import PostWrapTransparencyScript from "../components/partial/PostWrapTransparencyScript.astro";

type Props = {
  page: {
    data: CollectionEntry<"blog">[];
    url: {
      prev: string;
      next: string;
    };
    currentPage: number;
    lastPage: number;
  };
};

export async function getStaticPaths({ paginate }: { paginate: Function }) {
  const posts = await getCollection("blog");
  const sortedPosts = posts.sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
  );
  return paginate(sortedPosts, {
    pageSize: 5, // 只顯示 5 篇，因為左邊的 Sidebar 沒有 sticky
  });
}
const { page } = Astro.props;
---

<BaseLayout>
  <!-- Header -->
  <HeaderTitle title={SITE.title} url=`${BASE_URL}/` slot="header" />
  {/* slot 是 Astro 的俱名插槽，把 component 塞進指定 slot */}
  {
    SITE.subtitle && (
      <HeaderSubTitle
        subtitle={SITE.subtitle}
        url={`${BASE_URL}/`}
        slot="header"
      />
    )
  }
  <!-- Content -->
  <section id="main" aria-label="Main content">
    {
      // 非常重要，用條件渲染且引入元件的方式，實作 config 裡面 Home Categories 的開關
      HOME_CATEGORIES.enable && (
        <HomeCategories content={HOME_CATEGORIES.content} />
      )
    }
    {
      /* page.data 從 Astro.props 中解構出來，一頁有 pagesize 篇文章，
      用 map 把每一筆 post 轉換成 HTML 標籤 */
    }
    {
      page.data.map((post, index) => (
        <div class="post-wrapper">
          {/* 利用 { right: index % 2 === 1 } 這種動態 class 來實作左圖右文、右圖左文 */}
          <div
            class:list={["post-wrap", { right: index % 2 === 1 }]}
            data-aos="fade-up"
          >
            {/* 文章連結是基於 post 的 id attribute */}
            <a
              class="post-link"
              href={`${BASE_URL}/blog/${post.id}`}
              aria-label={post.id}
            />
            {/* 這段是文章的圖，不是背景大圖 */}
            <div class:list={["post-cover", { right: index % 2 === 1 }]}>
              {/* urlFor 定義在 utils ，保持模板 .astro 的乾淨 */}
              <img
                loading="lazy"
                src={urlFor(post.data.cover || randomCover() || BANNER)}
                alt={post.data.title}
              />
            </div>
            {/* 文章資訊 */}
            <div class="post-info">
              <div class="post-meta">
                <span>
                  <Icon name="fa6-solid:calendar" size={14} />
                  &nbsp;
                  {formatDate(post.data.pubDate)}
                </span>
                <span>
                  <Icon name="fa6-solid:pen-nib" size={14} />
                  &nbsp;
                  {_p("post.count", wordCount(post.body || ""))}
                </span>
                <span>
                  <Icon name="fa6-solid:hourglass-half" size={14} />
                  &nbsp;
                  {_p("post.time", readingTime(post.body || ""))}
                </span>
              </div>

              <h2 class="post-title">{post.data.title}</h2>

              <article class="post-article">
                {post.data.excerpt ? (
                  // 這段紀錄如果有 excerpt (摘要) 欄位，就把他當成預覽
                  <p>{post.data.excerpt}</p>
                ) : (
                  // 沒有 excerpt 就用 body 的前 300 字當作預覽
                  // 但可能會切到 html attribute, import, markdown 語法
                  // 所以寫 filter 過濾
                  <p>
                    {post.body
                      // 過濾 import
                      ?.replace(/import\s+.*?from\s+['"].*?['"];?/g, "\n")

                      // 過濾註解，變成換行
                      ?.replace(/\/\/.*$/gm, "\n")

                      // 過濾 HTML tag
                      ?.replace(/<[^>]+>/g, " ")

                      // 過濾 markdown 圖片語法，變成換行
                      ?.replace(/!\[.*?\]\(.*?\)/g, "\n")

                      // 過濾 markdown 標題
                      ?.replace(/^#+\s+.*$/gm, "")

                      // 過濾 markdown 程式碼區塊和行內程式碼
                      ?.replace(/```[\s\S]*?```|`.*?`/g, "")

                      // 過濾 markdown 粗體
                      ?.replace(/[*]/g, " ")

                      // 過濾 HTML entity
                      ?.replace(/&[a-z0-9]+;/g, " ")

                      // 先過濾每一行頭尾的空白，但換成換行
                      ?.replace(/^\s+|\s+$/gm, "\n")

                      // 再把多餘的空行過濾掉，替換成換行
                      ?.replace(/\n\s*\n/g, "\n")
                      ?.trim()
                      ?.slice(0, 300)}
                  </p>
                )}
              </article>
            </div>
          </div>
        </div>
      ))
    }
    {/* 把 page 物件(父層)傳遞給子組件(pagination) */}
    <Pagination
      prevUrl={page.url.prev}
      nextUrl={page.url.next}
      currentPage={page.currentPage}
      lastPage={page.lastPage}
      variant="glass"
    />
  </section>

  <!-- Footer -->
  <div slot="footer" class="footer-bg-wrapper">
    <BottomBackground />
    {/* 直接使用 Footer component ，所以 [...page] 沒有相關邏輯 */}
    {/* 外層已經有 footer 這個 slot 了，內層就不用了 */}
    <!-- <Footer slot="footer" /> -->
    <Footer />
  </div>
</BaseLayout>

<PostWrapTransparencyScript />

{/* scss 用來寫巢狀 css */}
<style lang="scss">
  /* 用來控制避免 Bottom Banner 因為渲染順序，直接覆蓋了 main section 的所有內容 */
  #main {
    position: relative;
    z-index: 1;
  }

  /* 確保選取到基於 post.id 的 貼文連結 */
  /* 效果：在卡片上方蓋一層透明的「點擊區」，讓使用者點擊卡片任何位置都能跳轉 */
  :global(.post-link) {
    width: 100%;
    height: 100%;

    top: 0;
    left: 0;

    position: absolute;
  }

  /* 每一張 post (的 container) */
  .post-wrap {
    width: 100%;
    height: 232px;

    margin-bottom: 32px;

    border-radius: 12px;
    /* 所有 post-wrap 都有透明度 */
    /* background: color-mix(in srgb, var(--color-wrap), transparent 60%); */
    background: var(--color-wrap);
    // backdrop-filter: blur(8px);
    // -webkit-backdrop-filter: blur(8px);

    // 根據 PostWrapTransparencyScript 的重和值，決定透明範圍
    // var(--post-wrap-overlap-px, 0px) 的 0px 是預設值，避免出錯
    &.has-bottom-overlap {
      background: linear-gradient(
        to top,
        color-mix(in srgb, var(--color-wrap), transparent 90%) 0,
        color-mix(in srgb, var(--color-wrap), transparent 90%)
          var(--post-wrap-overlap-fade-start-px, 0px),
        color-mix(in srgb, var(--color-wrap), transparent 75%)
          var(--post-wrap-overlap-px, 0px),
        var(--color-wrap) var(--post-wrap-overlap-px, 0px),
        var(--color-wrap) 100%
      );

      // 被 hover 就變成幾乎實心
      &:hover {
        background: color-mix(in srgb, var(--color-wrap), transparent 20%);
      }
    }

    &.is-full-bottom-overlap {
      background: linear-gradient(
        to top,
        color-mix(in srgb, var(--color-wrap), transparent 90%) 0,
        color-mix(in srgb, var(--color-wrap), transparent 75%) 100%
      );

      &:hover {
        background: color-mix(in srgb, var(--color-wrap), transparent 20%);
      }
    }

    /* 用來實作 post-link 中的「整張卡片都可以被點擊查看」 */
    position: relative;

    display: flex;
    /* 讓「圖片」和「文字」橫向排列 */
    flex-direction: row;
    transition: 0.3s;

    /* 如果有 .right 的 class 就反過來 */
    &.right {
      flex-direction: row-reverse;
    }

    @media screen and (max-width: 767px) {
      height: 400px;
      margin-bottom: 20px;

      flex-direction: column;
      
      &.right {
        flex-direction: column;
      }
    }
  }

  /* 深色模式下的 box 陰影，目的是讓卡片看起來會浮起來 */
  :global([data-theme='dark'])  {
    .post-wrap.left, .post-wrap.right {
      box-shadow: var(--shadow-card);
    }
  }

  /* 管理所有卡片(post-wrap)的區塊 */
  .post-wrapper {
    border-radius: 12px;
    transition: 0.3s;

    .aos-animate {
      /* 防止與 hover 衝突 */
      transition-property: initial !important;

      /* 電腦版才有滑鼠懸停， hover 後陰影變深 */
      @media screen and (min-width: 768px) {
        &:hover {
          box-shadow: var(--shadow-card-hover);
        }
      }
    }

    /* 為了效能提早告訴 browser 圖片要變形 */
    img {
      will-change: transform;
    }

    /* 電腦版才有滑鼠懸停，圖片放大效果 */
    @media screen and (min-width: 768px) {
      &:hover {
        transform: scale(1.01);

        img {
          transform: scale(1.05);
        }
      }
    }
  }

  /* 包含 meta(文章的日期、字數、閱讀時長), title, article */
  .post-info {
    height: 100%;
    width: 100%;

    /* 內距，文字不貼邊 */
    padding: 20px;
    overflow: hidden;
    /* padding 不會撐大框框 */
    box-sizing: border-box;
  }

  .post-meta {
    display: flex;
    justify-content: flex-end;

    /* 距離 title 空一點點距離 */
    margin: 4px 0;

    span {
      /* 數據間的距離 */
      margin: 0 12px;

      font-size: 14px;
      color: var(--grey-7);
      /* 強制不換行 */
      white-space: nowrap;
      /* 太長就顯示 ... */
      text-overflow: ellipsis;

      overflow: hidden;
      display: flex;
      align-items: center;

      @media screen and (max-width: 767px) {
        margin: 0 8px;
      }
    }
  }

  /* 文章預覽區塊 */
  .post-article {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    /* 只顯示 3 行，超過就變 ... */
    -webkit-line-clamp: 3;

    overflow: hidden;
    line-height: 32px;
    font-size: 15px;
    color: var(--grey-7);

    a {
      /* global.css 裡目前 --color-link: var(--red-1); */
      color: var(--color-link);
    }

    /* 保留換行符號 */
    white-space: pre-line;
  }

  /* 文章預覽封面 */
  .post-cover {
    width: 40%;
    min-height: 95px;

    background-color: var(--color-wrap);

    position: relative;
    overflow: hidden;
    
    /* 防止擠壓變形 */
    flex-shrink: 0;
    /* 滑鼠能穿透，點擊到下面的 post-link */
    pointer-events: none;

    @media screen and (max-width: 767px) {
      width: 100%;
      height: 45%;
    }

    @media screen and (min-width: 768px) {
      border-radius: 12px 0 0 12px;

      /* 讓卡片中的圖片和預覽文字中間的分隔線是斜線 */
      -webkit-clip-path: polygon(0 0, 92% 0%, 100% 100%, 0% 100%);
      clip-path: polygon(0 0, 92% 0%, 100% 100%, 0% 100%);

      &.right {
        border-radius: 0 12px 12px 0;
        -webkit-clip-path: polygon(0 0, 100% 0%, 100% 100%, 8% 100%);
        clip-path: polygon(0 0, 100% 0%, 100% 100%, 8% 100%);
      }
    }

    @media screen and (max-width: 767px) {
      border-radius: 12px 12px 0 0;

      &.right {
        border-radius: 12px 12px 0 0;
      }
    }

    img {
      width: 100%;
      height: 100%;
      /* 關鍵，圖片填滿而不變形 */
      object-fit: cover;
      
      left: 0;
      top: 0;

      display: block;
      transition: 0.2s;
      position: absolute;
    }
  }

  /* 文章預覽標題 */
  .post-title {
    padding: 20px 0;
    color: var(--color-link);
    font-size: 25px;
    letter-spacing: 1px;

    /* 強制不換行 */
    white-space: nowrap;
    overflow: hidden;

    /* 太長就顯示 ... */
    text-overflow: ellipsis;
    transition: color 0.3s;
  }

  /* 新增的底部背景大圖 */
  .footer-bg-wrapper {
    width: 100%;

    position: relative;
    
    /* 建立一個新的堆疊上下文，確保背景圖不會跑到 Wrapper 外面 */
    /* 這個堆疊是不可被插入的 (不受外界 index 影響) */
    isolation: isolate; 
  }

  /* 當窄螢幕下 Bottom Banner 會被隱藏時，Pagination 回到 archive 的實心樣式 */
  @media screen and (max-width: 767px) {
    :global(#page-nav.is-glass) {
      border: none;
      background: var(--color-wrap);
    }

    :global(#page-nav.is-glass:hover) {
      border-color: transparent;
      background: var(--color-wrap);
    }

    :global(#page-nav.is-glass .current) {
      background: var(--red-1);
      box-shadow: var(--shadow-red-6-shadow);
    }

    :global(#page-nav.is-glass .current:hover) {
      background: var(--red-2);
    }
  }

</style>
