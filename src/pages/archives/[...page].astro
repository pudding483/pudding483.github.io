---
import { getCollection, type CollectionEntry } from "astro:content";

import { BASE_URL } from "../../utils/config";
import { __ } from "../../utils/i18n";

import BaseLayout from "../../layouts/BaseLayout.astro";
import HeaderTitle from "../../components/partial/header/HeaderTitle.astro";
import CategoryList from "../../components/partial/CategoryList.astro";
import ArchiveList from "../../components/ArchiveList.astro";
import TagList from "../../components/partial/TagList.astro";
import Pagination from "../../components/Pagination.astro";
import BottomBackground from "../../components/BottomBackground.astro";
import Footer from "../../components/Footer.astro";

// Homepage uses paginate to generate route pages (Astro built-in helper)
export async function getStaticPaths({ paginate }: { paginate: Function }) {
  const posts = await getCollection("blog");
  posts.sort((a, b) => {
    // Sort by publish date, newest first
    return b.data.pubDate.getTime() - a.data.pubDate.getTime();
  });
  return paginate(posts, {
    // 10 posts per page
    pageSize: 10,
  });
}

type Props = {
  page: {
    data: CollectionEntry<"blog">[];
    url: {
      prev: string;
      next: string;
    };
    currentPage: number;
    lastPage: number;
  };
};

const { page } = Astro.props;
// group by year
const postsByYear: Map<number, CollectionEntry<"blog">[]> = new Map();
page.data.forEach((post) => {
  const year = post.data.pubDate.getFullYear();
  if (postsByYear.has(year)) {
    postsByYear.get(year)!.push(post);
  } else {
    postsByYear.set(year, [post]);
  }
});

const posts = await getCollection("blog");
const tags = new Set<string>();
const categories = new Set<string>();

// Collect tags and categories from all posts
posts.forEach((post) => {
  if (Array.isArray(post.data.tags)) {
    post.data.tags.forEach((tag) => {
      tags.add(tag);
    });
  }
  if (Array.isArray(post.data.categories)) {
    post.data.categories.forEach((category) => {
      categories.add(category);
    });
  }
});
---

<BaseLayout title={__("archive_a")}>
  <!-- Header -->
  <HeaderTitle
    title={__("archive_a")}
    url=`${BASE_URL}/archives`
    slot="header"
  />

  <!-- Content -->
  <section id="main" aria-label="Main content">
    <div class="archives-outer-wrap" data-aos="fade-up">
      <TagList tags={[...tags]} />
      <CategoryList categories={[...categories]} />
      <ArchiveList page={page} type="archives" />
    </div>

    <Pagination
      prevUrl={page.url.prev}
      nextUrl={page.url.next}
      currentPage={page.currentPage}
      lastPage={page.lastPage}
      url="/archives"
      variant="solid"
    />
  </section>

  <!-- Footer -->
  <div slot="footer" class="footer-bg-wrapper">
    <BottomBackground />
    <Footer />
  </div>
</BaseLayout>

<style>
  /* Keep main content above Bottom Banner layer */
  #main {
    position: relative;
    z-index: 1;
  }
  /* Archive content container background */
  .archives-outer-wrap {
    /* light theme --color-wrap: #fff */
    /* dark theme --color-wrap: #272b30 */
    background: var(--color-wrap);
    border-radius: 12px;
    padding: 16px 0;
  }

  .footer-bg-wrapper {
    width: 100%;
    position: relative;
    isolation: isolate; /* keep bottom background stacking context isolated */
  }
</style>
